[Unit]
Description=MedClinic Telegram bot
After=network-online.target medclinic.service
Wants=network-online.target

[Service]
User=medclinic
Group=www-data
WorkingDirectory=/opt/medclinic
EnvironmentFile=/opt/medclinic/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/medclinic/.venv/bin/python manage.py run_telegram_bot
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
